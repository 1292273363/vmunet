# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*

# Editor and OS temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
.*.swp
*.save

# Datasets and raw data
data/
raw_data/
datasets_raw/

# Pre-trained weights.
